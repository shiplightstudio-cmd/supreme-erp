# Copy this file to .env before starting Docker Compose, then replace secrets.

# MySQL database used by the ERP backend.
MYSQL_DATABASE=supreme_erp
MYSQL_USER=supreme_erp
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password

# n8n security and local URLs. Generate the encryption key with:
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
